cabal-version:      3.14
name:               musicjukebox
-- PVP summary:     +-+------- breaking API changes
--                  | | +----- non-breaking API additions
--                  | | | +--- code changes with no API change
version:            1.0.0.0

author:             gKrokod
category:           Sound
build-type:         Simple

extra-doc-files:    CHANGELOG.md


common common-extensions
  default-language: GHC2024
  default-extensions:
      OverloadedStrings
      DeriveGeneric
      OverloadedRecordDot
      DeriveAnyClass
      LambdaCase
      TypeApplications
      BangPatterns
      DataKinds
      GADTs
      CPP
common warnings
  ghc-options: -O2 -Wall -threaded
library 
    import:
        warnings
      , common-extensions
    hs-source-dirs: src
    exposed-modules:
      Handlers.Engine
      Handlers.LogicMemo
      Handlers.Logger
      Hotkey.Types
      Hotkey.Grab
      ShutDown.ConsoleHandler
      PlayerState
      Engine
      DataBase
      Logger
    build-depends: 
      aeson
      , base
      , text
      , time
      , directory
      , process
      , filepath
      , time
      , monatone
      , containers
      , bytestring
      , stm
      , async

    if os(windows)
      other-modules:
          Hotkey.Windows
          ShutDown.Windows
      build-depends:
          Win32
    else
      other-modules:
          Hotkey.Ubuntu
          ShutDown.Ubuntu
      build-depends:
          X11

executable musicjukebox-exe
    import:
      warnings
      , common-extensions
    main-is:          Main.hs

    build-depends:    
      base
      , musicjukebox
      ,bytestring
      , directory
      , process
      , filepath
      , monatone
      , text
      , time
      , stm
      , async
    hs-source-dirs:   app

benchmark musicjukebox
    -- Import common warning flags.
    import:
      warnings
      , common-extensions
    hs-source-dirs: bench
    main-is:    JukeBench.hs
    build-depends:    base
